<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.study.board.comment.CommentMapper">
    <resultMap id="commentResponseMap" type="com.study.board.comment.dto.CommentResponse">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="content" javaType="java.lang.String"/>
            <arg column="member_id" javaType="java.lang.Long"/>
            <arg column="post_id" javaType="java.lang.Long"/>
            <arg column="author_name" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <!--  댓글 작성후 응답으로 댓글 작성자 추가 응답  -->
    <select id="findByPostIdWithAuthor" resultMap="commentResponseMap">
        SELECT c.id, c.content, c.member_id, c.post_id, m.name AS author_name
        FROM comment c
        JOIN member m ON c.member_id = m.id
        WHERE c.post_id = #{postId}
        ORDER BY c.id
    </select>
</mapper>